* text=auto
# Keep compact package files identical to their checksum manifest.
submission/** text=auto eol=lf
# Keep research snapshot checksums identical across platforms.
data/raw/** -text
*.pdf binary
*.xlsx binary
*.png binary

# Preserve compact source snapshot bytes and mark the upload archive as binary.
submission/data/raw/** -text -whitespace
*.zip binary

# Validation logs preserve exact CLI stdout, including trailing spaces.
examples/validation/*.txt -whitespace
submission/examples/validation/*.txt -whitespace
